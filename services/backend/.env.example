# Copie para .env e ajuste. Todas as variáveis estão em giro/config.py.
GIRO_AMBIENTE=dev
GIRO_DATABASE_URL=postgresql+psycopg://giro:giro@localhost:5432/giro

# Em produção: segredo longo e aleatório (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
# GIRO_SEGREDO_JWT=cole-aqui-um-segredo-com-pelo-menos-32-caracteres
GIRO_COOKIE_SEGURO=false
GIRO_ORIGENS_CORS=["http://localhost:3000"]

# Notificação no celular. Gere com: uv run python -m giro.vapid
# GIRO_VAPID_CHAVE_PRIVADA=
# GIRO_VAPID_CHAVE_PUBLICA=
GIRO_VAPID_CONTATO=mailto:contato@giro.demo
